{
  // The environment background work — the runtime adapter that applies a published
  // snapshot — operates on. Requests do not use this: they name their own in the
  // X-Environment header.
  "Environment": "development",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173", "http://127.0.0.1:5173" ]
  },
  "Security": {
    "SigningKey": "development-signing-key-do-not-use-in-production-32chars",
    "Issuer": "BitWrite.OcelotControl",
    "Audience": "BitWrite.OcelotConsole.Api",
    "AccessTokenExpirationMinutes": "15",
    "RefreshTokenExpirationDays": "7"
  }
}
